PORT=5000
NODE_ENV=development

# Database configuration
# Set DB_CLIENT=mysql for MySQL database production, or leave default 'sqlite3' for local out-of-the-box dev
DB_CLIENT=sqlite3
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=fleettrack_db

# Security & JWT
JWT_SECRET=super-secret-fleettrack-jwt-key-2026-production
JWT_EXPIRES_IN=24h

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# Mapbox Token
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZGVtbyIsImEiOiJjbGVtc2ZlZXQxMjM0NTY3OCJ9.demo_token
